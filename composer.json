{
    "name": "rekhu/assistant-laravel",
    "description": "Rekhu Assistant for Laravel: a custom AI assistant inside your app, for your own customers: it answers, opens the right page and acts through the routes you mark, as the signed-in user, metered per customer by Rekhu.",
    "keywords": ["laravel", "ai", "assistant", "chat", "copilot", "customer support", "rekhu"],
    "homepage": "https://rekhu.com/products",
    "type": "library",
    "license": "proprietary",
    "authors": [{ "name": "Rekhu, a product of Charisma Design", "email": "hello@rekhu.com", "homepage": "https://rekhu.com" }],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": { "Rekhu\\Assistant\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Rekhu\\Assistant\\AssistantServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
